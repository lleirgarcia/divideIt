# Server Configuration
PORT=3051
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3050

# Logging
LOG_LEVEL=info

# File Upload Limits
MAX_FILE_SIZE=500000000

# FFmpeg Path (optional, defaults to system PATH)
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# Transcription API Keys (at least one required for transcription features)
# OpenAI Whisper API (recommended - https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
# Summarization model (optional; default: gpt-4o-mini). Use gpt-4o for best quality.
# OPENAI_SUMMARIZATION_MODEL=gpt-4o-mini

# Alternative transcription providers (optional)
# AssemblyAI (https://www.assemblyai.com/)
# ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Deepgram (https://deepgram.com/)
# DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Title overlay font (optional)
# Use a system font name (e.g. Georgia, Helvetica, Verdana) or register a custom .ttf/.otf:
# TITLE_FONT_FAMILY=Georgia
# TITLE_FONT_PATH=./fonts/MyFont.ttf

# Google Drive Integration (optional)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id_here
# GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret_here
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3051/api/google-drive/oauth/callback
# GOOGLE_DRIVE_REFRESH_TOKEN=your_refresh_token_here (obtained after OAuth flow)
